---
import '../styles/global.css';
import MediaFrame from '../components/MediaFrame.astro';
import ProcessVideo from '../components/ProcessVideo.astro';
import { business, capacities, clients, projects, testimonials } from '../data/business';
import { media } from '../data/media';
const title = `Maquinados CNC y torno industrial en Guadalajara${business.name ? ' | '+business.name : ''}`;
const description = 'Maquinados Industriales Castro: torneado y fresado CNC, piezas de gran tamaño, rectificado, fabricación de maquinaria y mantenimiento industrial en Guadalajara. Más de 20 años de experiencia y atención a empresas en todo México.';
const whatsappUrl = business.whatsapp ? `https://wa.me/${business.whatsapp}` : '';
const phoneHref = business.phone ? `tel:${business.phone.replace(/[^+\d]/g, '')}` : '';
const ready = business.publicReady && !!business.name && !!business.address && !!business.whatsapp && !!Astro.site;
const canonical = Astro.site ? new URL('/', Astro.site).href : undefined;
const icons = {
 torno: '<svg viewBox="0 0 32 32"><circle cx="9" cy="16" r="4"/><path d="M13 16h14M23 12v8M6 16H3"/></svg>',
 fresa: '<svg viewBox="0 0 32 32"><path d="M8 22V10h10l6 6v6H8z"/><path d="M18 10v6h6M8 16h10"/></svg>',
 grande: '<svg viewBox="0 0 32 32"><circle cx="16" cy="16" r="7"/><path d="M16 5v4M16 23v4M5 16h4M23 16h4"/></svg>',
 recto: '<svg viewBox="0 0 32 32"><path d="M6 22h20M8 22V14h16v8"/><path d="M12 14V9h8v5"/></svg>',
 conv: '<svg viewBox="0 0 32 32"><path d="M5 21h22M8 21V11h6v10M18 21V8h6v13"/></svg>',
 ref: '<svg viewBox="0 0 32 32"><rect x="6" y="8" width="14" height="16"/><path d="M20 12h6v12H12"/></svg>',
 diseno: '<svg viewBox="0 0 32 32"><path d="M8 24l8-16 8 16"/><path d="M11 18h10"/></svg>',
 maq: '<svg viewBox="0 0 32 32"><circle cx="16" cy="16" r="4"/><path d="M16 6v3M16 23v3M6 16h3M23 16h3M8.8 8.8l2.1 2.1M21.1 21.1l2.1 2.1M23.2 8.8l-2.1 2.1M10.9 21.1l-2.1 2.1"/></svg>',
 mant: '<svg viewBox="0 0 32 32"><path d="M13 19l8-8 3 3-8 8h-3v-3z"/><path d="M7 25l5-5"/></svg>',
};
const services = [
 {n:'01', id:'torno-cnc', icon:'torno', title:'Torneado CNC', label:'Control y repetibilidad', text:'Componentes de revolución sobre plano, en pieza única o producción recurrente.', tags:['Ejes y flechas','Bujes y casquillos'], value:'Torneado CNC'},
 {n:'02', id:'fresado-cnc', icon:'fresa', title:'Fresado CNC', label:'Geometrías a medida', text:'Superficies, cavidades y detalles con perfiladoras CNC, según el plano.', tags:['Placas y soportes','Ranuras y cavidades'], value:'Fresado CNC'},
 {n:'03', id:'tornos-grandes', icon:'grande', title:'Tornos de gran tamaño', label:'Gran formato', text:'Piezas grandes. El alcance se define con diámetro, longitud, peso y sujeción.', tags:['Ejes y rodillos','Componentes de maquinaria'], value:'Tornos de gran tamaño'},
 {n:'04', id:'rectificado', icon:'recto', title:'Rectificado', label:'Superficies funcionales', text:'Acabado según geometría, dureza y tolerancias indicadas en el plano.', tags:['Acabado','Ajustes dimensionales'], value:'Rectificado'},
 {n:'05', id:'convencional', icon:'conv', title:'Maquinado convencional', label:'Versatilidad en taller', text:'Torno y perfilado para reemplazos y operaciones complementarias.', tags:['Roscas y cuñeros','Barrenado'], value:'Maquinado convencional'},
 {n:'06', id:'refacciones', icon:'ref', title:'Refacciones sobre plano o muestra', label:'Piezas de reemplazo', text:'Reemplazos a partir de plano o muestra, tras revisar medidas y función.', tags:['Muestras y planos','Lotes a medida'], value:'Refacciones sobre plano o muestra'},
 {n:'07', id:'diseno', icon:'diseno', title:'Diseño e ingeniería', label:'Soluciones mecánicas', text:'Definición de piezas o conjuntos según el requerimiento del proyecto.', tags:['Piezas y conjuntos','Definición del trabajo'], value:'Diseño e ingeniería'},
 {n:'08', id:'maquinaria', icon:'maq', title:'Fabricación de maquinaria', label:'Equipos a medida', text:'Diseño y construcción de maquinaria y equipos, con alcance por revisión técnica.', tags:['Maquinaria especial','Equipos a medida'], value:'Fabricación de maquinaria'},
 {n:'09', id:'mantenimiento', icon:'mant', title:'Mantenimiento y reparación industrial', label:'Equipo en operación', text:'Revisión, reparación y mantenimiento de maquinaria y componentes.', tags:['Revisión','Reparación'], value:'Mantenimiento y reparación industrial'},
];
const machining = services.slice(0, 6);
const solutions = services.slice(6);
const faqs = [
 ['¿Qué información necesito para cotizar una pieza?', 'Plano o fotografías de referencia, medidas, material, cantidad y fecha requerida. Incluye tolerancias, acabado y uso de la pieza cuando los conozcas. La cotización depende de una revisión técnica.'],
 ['¿Puedo consultar un trabajo si solo tengo la pieza física?', 'Sí, puedes preparar tu consulta indicando que cuentas con una muestra. Será necesario revisar su estado, dimensiones y función antes de confirmar si puede fabricarse o repararse.'],
 ['¿Qué tamaño de pieza admiten los tornos grandes?', 'La capacidad depende del diámetro de volteo, longitud entre puntos, peso y sujeción. Comparte las dimensiones de tu pieza para confirmar su compatibilidad con el equipo.'],
 ['¿Se puede cotizar una sola pieza o un lote?', 'Indica la cantidad que necesitas y si habrá pedidos recurrentes. El volumen, la preparación de máquina y el material se consideran al evaluar cada solicitud.'],
];
const schema = ready ? {'@context':'https://schema.org','@type':'LocalBusiness',name:business.name,url:canonical,telephone:business.phone || undefined,address:{'@type':'PostalAddress',streetAddress:business.address,addressLocality:business.city,addressRegion:business.region,postalCode:business.postalCode || undefined,addressCountry:'MX'}} : null;
---
<!doctype html>
<html lang="es-MX">
 <head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{title}</title><meta name="description" content={description}/>
  <meta name="robots" content={ready ? 'index,follow' : 'noindex,nofollow'}/>
  {ready && <link rel="canonical" href={canonical}/>}
  <meta name="theme-color" content="#0c1e36"/>
  <meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:locale" content="es_MX"/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>}
 </head>
 <body>
  <a class="skip" href="#contenido">Saltar al contenido</a>
  {!ready && <div class="preview-note">PROPUESTA DE DISEÑO <span>Datos técnicos y contacto por completar · solicitudes sin envío</span></div>}
  <header class="header">
   <a class="brand" href="#inicio" aria-label="Maquinados Industriales Castro, inicio"><img class="brand-logo" src={business.logo} width="827" height="826" alt=""/><span class="brand-lockup"><span class="brand-name"><span class="brand-full">Maquinados Industriales Castro</span><span class="brand-short">MIC</span></span><small>MIC · Guadalajara</small></span></a>
   <nav aria-label="Navegación principal"><a href="#servicios">Servicios</a><a href="#capacidad">Capacidad</a><a href="#maquinaria">Maquinaria</a><a href="#contacto">Contacto</a></nav>
   <div class="header-actions">{phoneHref && <a class="header-phone" href={phoneHref}>{business.phoneLabel}</a>}<a class="button button-small" href="#cotizar">Preparar cotización <span aria-hidden="true">↗</span></a></div>
  </header>
  <main id="contenido">
   <section class="hero" id="inicio" aria-labelledby="hero-title">
    <div class="hero-copy"><p class="eyebrow"><span class="cross" aria-hidden="true">+</span> Guadalajara, Jalisco</p>
     <h1 id="hero-title">Maquinados CNC y torno industrial en Guadalajara</h1>
     <p class="hero-lead">Precisión que construye soluciones.</p>
     <p class="hero-years">{business.experience}</p>
     <ul class="hero-attrs"><li>Torno y fresado CNC</li><li>Atención nacional</li></ul>
     <div class="hero-actions"><a class="button" href="#cotizar">Preparar cotización <span aria-hidden="true">↗</span></a><a class="text-link" href="#servicios">Conocer nuestros servicios <span aria-hidden="true">↓</span></a></div>
     <p class="hero-note">Primero reúnes los datos de la pieza. Después, Continuar en WhatsApp abre la aplicación con el texto; el mensaje no se envía solo.</p>
    </div>
    <figure class="hero-image"><img src={media.hero.src} srcset={media.hero.srcset} sizes="(max-width: 760px) 100vw, 53vw" width={media.hero.width} height={media.hero.height} alt={media.hero.alt} fetchpriority="high"/><div class="image-top"><span>PROCESOS INDUSTRIALES</span><span aria-hidden="true">↗</span></div><figcaption><span>Del requerimiento<br/><strong>al maquinado.</strong></span><small>{media.hero.caption}<br/>{media.hero.credit}</small></figcaption></figure>
   </section>
   <div class="process-strip" aria-label="Servicios principales"><span>CAPACIDAD DE TALLER</span><b>Torno CNC</b><b>Fresado CNC</b><b>Gran formato</b><b>Rectificado</b><b>Maquinaria</b><b>Mantenimiento</b></div>
   <section class="trust" aria-label="Trayectoria y cobertura"><div><span>Trayectoria</span><strong>Más de 20 años de experiencia</strong></div><div><span>Cliente confirmado</span>{clients.map(client=><strong class="client-name">{client}</strong>)}</div><div><span>Cobertura</span><strong>Atención a empresas en todo México</strong></div></section>
   <section class="section" id="servicios">
    <div class="section-heading"><div><p class="eyebrow">01 / SERVICIOS</p><h2>El proceso adecuado.<br/>Para tu pieza.</h2></div><p>El alcance se define con tu plano, material y especificaciones.</p></div>
    <div class="service-group"><h3 class="group-title">Maquinado y precisión</h3><div class="services">{machining.map(s=><article class="service" id={s.id}><div class="service-top"><span class="service-icon" aria-hidden="true" set:html={icons[s.icon]}></span><span>{s.n}</span></div><p class="eyebrow">{s.label}</p><h4>{s.title}</h4><p>{s.text}</p><ul class="tags">{s.tags.map(t=><li>{t}</li>)}</ul><a class="service-link" href="#cotizar" data-service={s.value}>Consultar este servicio <span aria-hidden="true">↗</span></a></article>)}</div></div>
    <div class="service-group"><h3 class="group-title">Soluciones industriales</h3><div class="services services-solutions">{solutions.map(s=><article class="service" id={s.id}><div class="service-top"><span class="service-icon" aria-hidden="true" set:html={icons[s.icon]}></span><span>{s.n}</span></div><p class="eyebrow">{s.label}</p><h4>{s.title}</h4><p>{s.text}</p><ul class="tags">{s.tags.map(t=><li>{t}</li>)}</ul><a class="service-link" href="#cotizar" data-service={s.value}>Consultar este servicio <span aria-hidden="true">↗</span></a></article>)}</div></div>
    <p class="section-note">Las aplicaciones se evalúan según material, dimensiones, tolerancias y capacidad del equipo.</p>
   </section>
   <section class="capacity section" id="capacidad">
    <MediaFrame class="capacity-photo" item={media.largeLathe} sizes="(max-width: 760px) 92vw, 48vw" />
    <div class="capacity-copy">
     <p class="eyebrow">02 / TORNOS GRANDES</p><h2>Cuatro datos<br/>definen el alcance.</h2><p>Para una pieza grande no publicamos cifras de máquina. Compartes estas condiciones y el taller confirma si el equipo puede tomarla.</p><a class="text-link light" href="#cotizar" data-service="Tornos de gran tamaño">Consultar una pieza de gran tamaño <span aria-hidden="true">↗</span></a>
     <div class="capacity-list"><div><span>01</span><p>Diámetro<small>Volteo y zonas a maquinar.</small></p></div><div><span>02</span><p>Longitud<small>Distancia de trabajo de la pieza.</small></p></div><div><span>03</span><p>Peso<small>Peso aproximado para manejo y montaje.</small></p></div><div><span>04</span><p>Sujeción<small>Cómo se monta y qué pide el plano.</small></p></div></div>
    </div>
   </section>
   <section class="section equipment" id="maquinaria"><div class="section-heading"><div><p class="eyebrow">EL TALLER DETRÁS DE CADA PIEZA</p><h2>La capacidad se demuestra.<br/>Con equipo y especificaciones.</h2></div><p>Varios equipos CNC, tornos de gran tamaño,<br/>perfiladoras y rectificadoras.<br/>El proceso se define según tu proyecto.</p></div><div class="shop-gallery"><MediaFrame class="gallery-main" item={media.operation} sizes="(max-width: 760px) 92vw, 58vw" /><MediaFrame item={media.parts} sizes="(max-width: 760px) 46vw, 28vw" /><MediaFrame item={media.facility} sizes="(max-width: 760px) 46vw, 28vw" /></div><ProcessVideo /><div class="equipment-table" role="region" aria-label="Fichas resumidas de maquinaria" tabindex="0"><table><thead><tr><th>Familia de equipo</th><th>Estado</th><th>Aplicación</th><th>Datos por completar</th></tr></thead><tbody>{capacities.map(c=><tr><th scope="row">{c.machine}</th><td><span class={`status status-${c.status}`}>{c.status === 'confirmed' ? 'Equipo confirmado' : 'Propuesto'}</span></td><td>{c.description}</td><td class="pending">{c.specification}</td></tr>)}</tbody></table></div><p class="section-note">Las familias de equipo están confirmadas; las dimensiones, modelos y capacidades exactas siguen pendientes. Las fotografías marcadas como referencia no son instalaciones ni trabajos de MIC. Sustituye archivos y textos en src/data/media.ts.</p></section>
   <section class="section workflow" id="proceso"><div class="section-heading"><div><p class="eyebrow">03 / DE TU PLANO AL TALLER</p><h2>Una buena pieza empieza<br/>con información clara.</h2></div><a class="text-link" href="#cotizar">Preparar mi solicitud <span aria-hidden="true">↗</span></a></div><ol class="steps"><li><span>01</span><h3>Describe tu proyecto</h3><p>Reúne el plano o la muestra, el material y la cantidad de piezas.</p></li><li><span>02</span><h3>Confirma la viabilidad</h3><p>El taller revisa dimensiones, operaciones y requisitos técnicos.</p></li><li><span>03</span><h3>Acuerda el alcance</h3><p>Define precio, entrega y condiciones antes de iniciar el trabajo.</p></li></ol></section>
   <section class="quote section" id="cotizar"><div class="quote-intro"><p class="eyebrow">04 / COTIZA TU PROYECTO</p><h2>Cuéntanos<br/>qué necesitas<br/><em>maquinar.</em></h2><p>Prepara los datos de tu pieza. Al terminar podrás copiar la solicitud o continuar en WhatsApp. Abrir la aplicación no envía el mensaje.</p><div class="quote-location"><span aria-hidden="true">↗</span><div>Guadalajara, Jalisco<small>{business.address || 'Torno CNC · Fresado CNC · Rectificado'}</small></div></div>{!business.whatsapp && <p class="demo-notice">Esta propuesta permite preparar y copiar tu solicitud. El envío al taller se habilitará con su número de contacto.</p>}</div>
    <form id="quote-form" data-whatsapp={business.whatsapp}>
     <div class="form-row"><label>Servicio<select name="service" id="service" required><option value="">Selecciona un servicio</option>{services.map(s=><option>{s.value}</option>)}<option>Necesito orientación</option></select></label><label>Cantidad de piezas<input name="quantity" type="number" inputmode="numeric" min="1" step="1" placeholder="Ej. 20" required/></label></div>
     <div class="form-row"><label>Material <span>(si lo conoces)</span><input name="material" maxlength="100" placeholder="Ej. acero, aluminio, bronce"/></label><label>Fecha requerida <span>(opcional)</span><input name="date" type="date"/></label></div>
     <label>Describe la pieza o el trabajo<textarea name="description" minlength="10" maxlength="2000" rows="4" required placeholder="Medidas aproximadas, uso de la pieza, tolerancias y si tienes plano o muestra…"></textarea></label>
     <p class="form-help">Ten a la mano tu plano o fotografías para compartirlos al contactar al taller.</p>
     <button class="button" type="submit">Preparar solicitud <span aria-hidden="true">↗</span></button>
     <p class="privacy-note">Los datos se procesan en tu navegador. Preparar una solicitud no confirma precio, viabilidad ni fecha de entrega.</p>
     <section class="quote-result" id="quote-result" hidden aria-labelledby="result-title"><h3 id="result-title" tabindex="-1">Tu solicitud está lista para compartir</h3><p class="form-help">Todavía no se ha enviado. Al continuar se abre WhatsApp con el texto; el mensaje sale solo cuando tú lo confirmas en la aplicación.</p><textarea id="quote-summary" readonly aria-label="Resumen de tu solicitud" rows="8"></textarea><div class="result-actions"><button class="button button-small" type="button" id="copy-quote">Copiar solicitud</button>{whatsappUrl && <a class="button button-small" id="send-whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Continuar en WhatsApp</a>}</div><p id="copy-status" role="status"></p></section>
    </form>
   </section>
   {projects.length > 0 && <section class="section projects" id="proyectos"><div class="section-heading"><div><p class="eyebrow">PROYECTOS VERIFICADOS</p><h2>Necesidad, proceso<br/>y resultado.</h2></div><p>Casos documentados con información autorizada por el cliente.</p></div><div class="project-grid">{projects.map(project=><article>{project.image && <img src={project.image} alt={project.imageAlt || ''} loading="lazy"/>}<h3>{project.title}</h3><dl><div><dt>Necesidad</dt><dd>{project.need}</dd></div><div><dt>Material</dt><dd>{project.material}</dd></div><div><dt>Dimensiones</dt><dd>{project.dimensions}</dd></div><div><dt>Proceso</dt><dd>{project.process}</dd></div><div><dt>Resultado</dt><dd>{project.result}</dd></div></dl></article>)}</div></section>}
   {testimonials.length > 0 && <section class="section testimonials"><p class="eyebrow">EXPERIENCIAS DE NUESTROS CLIENTES</p><h2>El trabajo habla.<br/>Nuestros clientes también.</h2><div class="testimonial-grid">{testimonials.map(t=><figure><blockquote>{t.quote}</blockquote><figcaption><strong>{t.name}</strong><span>{t.role} · {t.company}</span></figcaption></figure>)}</div></section>}
   <section class="section faq" id="preguntas"><div><p class="eyebrow">ANTES DE COTIZAR</p><h2>Resolvamos<br/>lo esencial.</h2></div><div>{faqs.map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></section>
   <section class="contact section" id="contacto"><div><p class="eyebrow">05 / CONTACTO</p><h2>Hablemos de<br/>tu proyecto.</h2><p>Atención a empresas desde Guadalajara y en todo México.</p></div><address class="contact-list"><div><span>Ubicación</span><strong class={business.address ? undefined : 'is-pending'}>{business.address || 'Domicilio por completar'}</strong><small>{business.postalCode ? `${business.city}, ${business.region}, C.P. ${business.postalCode}` : `${business.city}, ${business.region}`}</small>{business.mapsUrl && <a href={business.mapsUrl} target="_blank" rel="noopener noreferrer">Abrir en Maps ↗</a>}</div><div><span>Teléfono y WhatsApp</span>{phoneHref ? <a href={phoneHref}>{business.phoneLabel}</a> : <strong>Teléfono por completar</strong>}{whatsappUrl && <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">Abrir WhatsApp ↗</a>}</div><div><span>Correo</span>{business.email ? <a href={`mailto:${business.email}`}>{business.email}</a> : <strong class="is-pending">Correo por completar</strong>}</div><div><span>Horario</span><strong class={business.hours ? undefined : 'is-pending'}>{business.hours || 'Horario por completar'}</strong></div>{business.facebook && <div><span>Facebook</span><a href={business.facebook} target="_blank" rel="noopener noreferrer">Maquinados Industriales Castro ↗</a></div>}</address></section>
  </main>
  <footer><div class="footer-top"><a class="brand" href="#inicio" aria-label="Maquinados Industriales Castro, inicio"><img class="brand-logo" src={business.logo} width="827" height="826" alt=""/><span class="brand-lockup"><span class="brand-name">Maquinados Industriales Castro</span><small>MIC · Guadalajara</small></span></a><p>El siguiente paso de tu proyecto<br/>empieza con una conversación.</p><div class="footer-links"><a class="text-link light" href="#cotizar">Preparar mi cotización ↗</a>{business.facebook && <a class="text-link light" href={business.facebook} target="_blank" rel="noopener noreferrer">Facebook ↗</a>}</div></div><div class="footer-bottom"><span>Guadalajara, Jalisco, México</span><span>{ready ? business.name : 'Propuesta visual · información comercial por confirmar'}</span></div></footer>
  <script>
   const form = document.querySelector<HTMLFormElement>('#quote-form')!;
   const service = document.querySelector<HTMLSelectElement>('#service')!;
   document.querySelectorAll<HTMLAnchorElement>('[data-service]').forEach(link => link.addEventListener('click', () => { service.value = link.dataset.service || ''; }));
   form.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const value = (key:string) => String(data.get(key) || '').trim();
    const summary = `Hola, quisiera cotizar un trabajo de maquinado.\n\nServicio: ${value('service')}\nCantidad: ${value('quantity')}\nMaterial: ${value('material') || 'Por definir'}\nFecha requerida: ${value('date') || 'Por acordar'}\n\nDescripción:\n${value('description')}\n\nQuedo pendiente de la revisión técnica y cotización.`;
    document.querySelector<HTMLTextAreaElement>('#quote-summary')!.value = summary;
    document.querySelector<HTMLElement>('#quote-result')!.hidden = false;
    document.querySelector<HTMLElement>('#result-title')!.focus();
    const whatsapp = document.querySelector<HTMLAnchorElement>('#send-whatsapp');
    const phone = form.dataset.whatsapp || '';
    if (whatsapp && /^\d{10,15}$/.test(phone)) whatsapp.href = `https://wa.me/${phone}?text=${encodeURIComponent(summary)}`;
   });
   document.querySelector('#copy-quote')!.addEventListener('click', async () => {
    const field = document.querySelector<HTMLTextAreaElement>('#quote-summary')!;
    const status = document.querySelector<HTMLElement>('#copy-status')!;
    try { await navigator.clipboard.writeText(field.value); status.textContent = 'Solicitud copiada. Puedes pegarla en tu mensaje.'; }
    catch { field.focus(); field.select(); status.textContent = 'Seleccionamos el texto. Usa la opción Copiar de tu dispositivo.'; }
   });
  </script>
 </body>
</html>
